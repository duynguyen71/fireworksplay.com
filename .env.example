# React Environment Variables
# Copy this file to .env and update with your Cloudflare Worker URL

# Cloudflare Worker API URL (REQUIRED)
# Get this URL after deploying your Cloudflare Worker
REACT_APP_WORKER_API_URL=https://your-worker-domain.your-subdomain.workers.dev

# Examples:
# REACT_APP_WORKER_API_URL=https://fireworksplay-notion-api.your-username.workers.dev
# REACT_APP_WORKER_API_URL=https://api.fireworksplay.com (if using custom domain)